meta {
  name: Setup Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/setup
  body: json
  auth: none
}

body:json {
  {
    "householdName": "My Nook",
    "name": "Daniel",
    "email": "daniel@test.com",
    "password": "AdminStrongPassword123!"
  }
}

assert {
  res.status: in [201, 403]
}
