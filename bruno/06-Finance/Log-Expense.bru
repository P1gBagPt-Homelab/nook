meta {
  name: Log Expense
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/finance/expenses
  body: json
  auth: none
}

body:json {
  {
    "title": "Smoke Test Expense",
    "amount": 12.50,
    "isSplit": false
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.title: eq Smoke Test Expense
}
