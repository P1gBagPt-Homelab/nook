# ==============================================================================
# PROJECT JANUS — CORE SERVICES ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure the credentials for your project.
# In production on Coolify, set these environment variables directly inside the
# Coolify UI under: Project > Application > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=my-app-name
APP_ENV=production
APP_PORT=3000
APP_SECRET=replace_with_openssl_rand_hex_32
APP_URL=https://my-app.janus-lab.duckdns.org

# ------------------------------------------------------------------------------
# 2. SHARED POSTGRESQL 18 (Multi-Tenant)
# ------------------------------------------------------------------------------
# Project Janus runs a centralized PostgreSQL 18 container on the 'coolify' network.
# NEVER run a standalone Postgres container for your app. Provision an isolated
# database and user using scripts/provision-db.sh or via psql.
#
# Standard format: postgresql://<user>:<password>@<postgres_container_name>:5432/<db_name>
# For Python asyncpg: postgresql+asyncpg://<user>:<password>@<postgres_container_name>:5432/<db_name>
DATABASE_URL=postgresql://app_user:GeneratedSecurePasswordHere@postgres:5432/app_db

# ------------------------------------------------------------------------------
# 3. SHARED REDIS 7.2 (Cache, Rate Limiting, Celery/BullMQ)
# ------------------------------------------------------------------------------
# Shared Redis instance running on the 'coolify' network.
# Allocate a dedicated database index (0 to 15) to isolate keys from other projects.
# Standard format: redis://:<password>@<redis_container_name>:6379/<db_index>
REDIS_URL=redis://:YourRedisPasswordHere@redis:6379/3

# ------------------------------------------------------------------------------
# 4. SHARED MINIO S3 OBJECT STORAGE (Files, Uploads, Backups)
# ------------------------------------------------------------------------------
# High-capacity S3 object storage on Project Janus (backed by 1TB HDD storage).
# S3 Internal Endpoint (inside coolify Docker network): http://minio:9000
# S3 Public Endpoint (browser uploads/presigned URLs): https://s3.janus-lab.duckdns.org
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://s3.janus-lab.duckdns.org
S3_BUCKET=my-app-data
S3_ACCESS_KEY=YourProjectSpecificAccessKey
S3_SECRET_KEY=YourProjectSpecificSecretKey
S3_REGION=us-east-1
S3_USE_SSL=false

# ------------------------------------------------------------------------------
# 5. SHARED RABBITMQ (Async Tasks, Decoupled Message Queues)
# ------------------------------------------------------------------------------
# Central AMQP message broker running on the 'coolify' network.
# Use a dedicated virtual host (vhost) e.g. /my-app and a dedicated user.
# Internal AMQP Endpoint: amqp://<user>:<password>@rabbitmq:5672/<vhost>
RABBITMQ_URL=amqp://my_app_user:YourRabbitPasswordHere@rabbitmq:5672/my_app

# ------------------------------------------------------------------------------
# 6. LOCAL AI (Ollama GPU Inference — RTX 2070 8GB VRAM)
# ------------------------------------------------------------------------------
# Direct container-to-container access to local LLM models with zero external API cost.
# Internal Endpoint: http://ollama:11434
# Available models: llama3.1:8b, mistral:7b, phi3:mini, nomic-embed-text
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# 7. ERROR & CRASH TRACKING (GlitchTip / Sentry-Compatible)
# ------------------------------------------------------------------------------
# GlitchTip captures full stack traces, local variables, and runtime crash forensics.
# Obtain your project DSN from https://errors.janus-lab.duckdns.org
SENTRY_DSN=https://your_key_here@errors.janus-lab.duckdns.org/1
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & METRICS (Prometheus / Grafana)
# ------------------------------------------------------------------------------
# Expose metrics on /metrics for Prometheus scraping (Guide 16).
METRICS_ENABLED=true
METRICS_PORT=3000
