{
  "name": "nook",
  "version": "1.0.0",
  "private": true,
  "description": "Nook — Open-Source Modular Household & Life Operating System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "dev:api": "npm run dev --workspace=@nook/api",
    "dev:web": "npm run dev --workspace=@nook/web",
    "build:shared": "npm run build --workspace=@nook/shared",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "pretest": "npm run build:shared",
    "prelint:spectral": "npm run build:shared",
    "db:generate": "npm run db:generate --workspace=@nook/api",
    "db:migrate": "npm run db:migrate --workspace=@nook/api",
    "test": "npm run test --workspaces --if-present",
    "lint:spectral": "tsx scripts/lint-spectral.js",
    "test:bruno": "tsx scripts/run-bruno.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@stoplight/spectral-cli": "^6.14.0",
    "@usebruno/cli": "^1.39.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
